tripitaka.shop, www.tripitaka.shop {
    root * /srv/jingzang/current
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Content-Security-Policy "default-src 'self'; script-src 'self' https://www.youtube.com https://s.ytimg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://www.youtube.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com; media-src 'self' https://buddhisttemple.ca; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Cache-Control no-cache
    }
    request_body {
        max_size 64KB
    }
    reverse_proxy /api/visits 127.0.0.1:8766
    file_server
}
