[Unit]
Description=Football Know continuous public-data synchronizer
After=network-online.target footballknow-web.service
Wants=network-online.target

[Service]
User=footballknow
Group=footballknow
WorkingDirectory=/opt/footballknow
Environment=FOOTBALL_STATE_DIR=/var/lib/footballknow
# Scores and quotes use this base cadence; profiles and financial statements have longer defaults.
Environment=FOOTBALL_SYNC_SECONDS=60
Environment=FOOTBALL_MET_TERMS_ACCEPTED=1
Environment=FOOTBALL_SYNC_WORKERS=2
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
ExecStart=/opt/footballknow/.venv/bin/python worker.py
Restart=always
RestartSec=10
TimeoutStopSec=620
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/footballknow/public
ReadWritePaths=/var/lib/footballknow
UMask=0077

[Install]
WantedBy=multi-user.target
