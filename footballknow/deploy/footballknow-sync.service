[Unit]
Description=Update Football Know public datasets
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=caddy
Group=caddy
WorkingDirectory=/opt/footballknow
ExecStart=/usr/bin/python3 /opt/footballknow/sync_data.py
TimeoutStartSec=180
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/footballknow/public
