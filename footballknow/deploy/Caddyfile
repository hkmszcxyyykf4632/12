footballknow.art, www.footballknow.art, inwesting.shop, www.inwesting.shop {
    root * /opt/footballknow/public
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.tencent.com https://racing.hkjc.com https://consvc.hkjc.com https://resources.premierleague.com https://a.espncdn.com https://thumb.wikimedia.org https://upload.wikimedia.org https://newsstatic.rthk.hk https://res.hkjc.com; connect-src 'self'; frame-src https://racing.hkjc.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    }
    @api path /api/*
    header @api Cache-Control "no-store"
    @static not path /api/* /media/videos/*
    header @static Cache-Control "no-cache"
    @video path /media/videos/*
    header @video Cache-Control "public, max-age=86400"
    @video_download {
        path /media/videos/*.mp4 /media/videos/*.webm
        query download=1
    }
    header @video_download Content-Disposition "attachment"
    request_body {
        max_size 64KB
    }
    redir /jingzang https://tripitaka.shop/ 308
    handle_path /jingzang/* {
        redir https://tripitaka.shop{uri} 308
    }
    reverse_proxy /api/* 127.0.0.1:8765
    file_server
}
