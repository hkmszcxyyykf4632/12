footballknow.art, www.footballknow.art {
    root * /opt/footballknow/public
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    }
    @api path /api/*
    header @api Cache-Control "no-store"
    @static not path /api/*
    header @static Cache-Control "no-cache"
    request_body {
        max_size 64KB
    }
    reverse_proxy /api/* 127.0.0.1:8765
    file_server
}
